# PayPal Developer Dashboard -> Apps & Credentials (SANDBOX)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Firma de los QR (cambia esto)
QR_SECRET=cambia-esto-por-un-secreto-largo

# PayPal webhooks (Developer Dashboard -> Apps & Credentials -> Webhooks)
# Sin PAYPAL_WEBHOOK_ID los eventos se aceptan sin verificar (solo demo).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Aviso opcional al completarse un pago (Slack-compatible incoming webhook)
B2B_NOTIFY_WEBHOOK_URL=

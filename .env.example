# PayPal Developer Dashboard -> Apps & Credentials (SANDBOX)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Firma de los QR (cambia esto)
QR_SECRET=cambia-esto-por-un-secreto-largo

# Persistencia B2B. Si DATABASE_URL falta, se usa SQLite local.
DATABASE_URL=
# B2B_SQLITE_PATH=b2b/data/b2b.sqlite3
# B2B_CHECKPOINT_PATH=b2b/data/checkpoints.sqlite3

# Channel3 (opcional; sin key se usa el catálogo local)
CHANNEL3_API_KEY=
CHANNEL3_MODE=agentic

# Defaults B2B (opcional)
B2B_CURRENCY=USD
B2B_MAX_DELEGATION=250000
B2B_MANDATE_TTL=900

# PayPal webhooks (Developer Dashboard -> Apps & Credentials -> Webhooks)
# Sin PAYPAL_WEBHOOK_ID los eventos se aceptan sin verificar (solo demo).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Aviso opcional al completarse un pago (Slack-compatible incoming webhook)
B2B_NOTIFY_WEBHOOK_URL=
